// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(USER)
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]

  @@index([username])
  @@index([email])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model AppSettings {
  id                Int      @id @default(autoincrement())
  key               String   @unique
  value             String
  updatedAt         DateTime @updatedAt
  updatedBy         Int?

  @@index([key])
}

model ComponentCost {
  id            Int      @id @default(autoincrement())
  component     String
  tickets1      Float    @default(0)
  tickets10     Float    @default(0)
  tickets100    Float    @default(0)
  tickets1000   Float    @default(0)
  tickets5000   Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([component])
  @@index([component])
}

enum Role {
  ADMIN
  USER
}