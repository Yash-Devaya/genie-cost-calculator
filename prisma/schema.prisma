// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  password        String
  role            Role     @default(USER)
  email           String?  @unique
  isSuperAdmin    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sessions        Session[]
  settingsUpdated AppSettings[]

  @@index([username])
  @@index([email])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model AppSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy Int?
  updater   User?    @relation(fields: [updatedBy], references: [id])

  @@index([key])
}

// NEW: Product model
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  icon        String?  // Optional icon/image URL
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans       Plan[]

  @@index([name])
  @@index([isActive])
}

model Plan {
  id          Int         @id @default(autoincrement())
  productId   Int         // Link to product
  name        String
  description String
  isActive    Boolean     @default(true)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  categories  Category[]
  customFields CustomField[]

  @@index([productId])
  @@index([name])
  @@index([isActive])
}

model Category {
  id          Int         @id @default(autoincrement())
  planId      Int
  name        String
  order       Int         @default(0)
  showTotal   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  components  Component[]

  @@index([planId])
  @@index([order])
}

model CustomField {
  id          Int      @id @default(autoincrement())
  planId      Int
  name        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([order])
}

model Component {
  id               Int      @id @default(autoincrement())
  categoryId       Int
  name             String
  order            Int      @default(0)
  tickets1         Float    @default(0)
  tickets10        Float    @default(0)
  tickets100       Float    @default(0)
  tickets1000      Float    @default(0)
  tickets5000      Float    @default(0)
  customFieldData  Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([order])
}

model ComponentCost {
  id          Int      @id @default(autoincrement())
  component   String
  tickets1    Float    @default(0)
  tickets10   Float    @default(0)
  tickets100  Float    @default(0)
  tickets1000 Float    @default(0)
  tickets5000 Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([component])
  @@index([component])
}

model Region {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  multipliers RegionMultiplier[]

  @@index([name])
  @@index([order])
}

model CostMultiplierProfile {
  id          Int      @id @default(autoincrement())
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  multipliers RegionMultiplier[]

  @@index([name])
  @@index([isDefault])
}

model RegionMultiplier {
  id          Int                   @id @default(autoincrement())
  profileId   Int
  regionId    Int
  multiplier  Float
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  profile     CostMultiplierProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  region      Region                @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([profileId, regionId])
  @@index([profileId])
  @@index([regionId])
}

enum Role {
  ADMIN
  USER
}